   "inch": null,
   "layer": "marker",
   "x_pt": 97.6,
   "y_pt": 655.3,
   "x_mm": 34.4,
   "y_mm": 231.2
  },
  {
   "text": "생산에 필요한 요척",
   "kind": "label",
   "inch": null,
   "layer": "marker",
   "x_pt": 197.7,
   "y_pt": 655.3,
   "x_mm": 69.7,
   "y_mm": 231.2
  },
  {
   "text": "을 구함과 동시에",
   "kind": "label",
   "inch": null,
   "layer": "marker",
   "x_pt": 269.1,
   "y_pt": 655.3,
   "x_mm": 94.9,
   "y_mm": 231.2
  },
  {
   "text": "효율적인 배치",
   "kind": "label",
   "inch": null,
